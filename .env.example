# Shared simulation language: zh-CN (default) or en
WORLD_LOCALE=zh-CN

# Provider: ollama | openai | together | custom
LLM_PROVIDER=ollama

# Ollama — Qwen is recommended for the Chinese Lighthouse Town setting.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
# Alternative local chat model, if that is its exact local tag:
# OLLAMA_MODEL=gemma3:12b
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
OLLAMA_EMBEDDING_DIMENSION=1024

# OpenAI
# OPENAI_API_KEY=
# OPENAI_API_URL=https://api.openai.com
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_DIMENSION=1536

# Together.ai
# TOGETHER_API_KEY=
# TOGETHER_API_URL=https://api.together.xyz
# TOGETHER_CHAT_MODEL=meta-llama/Llama-3-8b-chat-hf
# TOGETHER_EMBEDDING_MODEL=togethercomputer/m2-bert-80M-8k-retrieval
# TOGETHER_EMBEDDING_DIMENSION=768

# Generic OpenAI-compatible service (LM Studio, vLLM, LocalAI, or another provider).
# Use the API base URL; a trailing /v1 is accepted and normalized.
# LLM_API_URL=http://127.0.0.1:1234/v1
# LLM_API_KEY=
# LLM_MODEL=qwen-local
# LLM_EMBEDDING_MODEL=text-embedding-local
# LLM_EMBEDDING_DIMENSION=1024
